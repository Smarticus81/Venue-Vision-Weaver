# Copy these into Railway -> your service -> Variables
# REQUIRED for email + share links: your Railway public URL (or rely on RAILWAY_PUBLIC_DOMAIN)
# Generated from .env.example: same keys, production values. Keep the two files in sync.

# --- App ---
PORT=5000
# Public site URL for email links, share URLs, and Stripe redirects (no trailing slash).
APP_BASE_URL=https://YOUR-SERVICE.up.railway.app
# On Railway you can omit this if RAILWAY_PUBLIC_DOMAIN is set, or set explicitly:
# APP_BASE_URL=https://app.yourdomain.com
# Turns on strict boot-time validation: the server refuses to start with
# missing/placeholder production config (Stripe, Resend, storage, AI keys)
# instead of silently degrading (e.g. emails that never send).
NODE_ENV=production
# Signs the short-lived couple upload tokens. Generate with `pnpm run generate:secrets`.
UPLOAD_TOKEN_SECRET=generate-a-second-long-random-string
# Optional cleanup tuning. Defaults are production-safe; raise only for high-volume deployments.
# UPLOAD_INTENT_CLEANUP_BATCH_SIZE=100
# Minutes between sweeps of expired, unused upload intents (default 15).
# UPLOAD_INTENT_CLEANUP_INTERVAL_MINUTES=15
# Upload-intent caps per venue: owner venue photos per day, couple photos per hour.
# UPLOAD_INTENT_VENUE_DAILY_CAP=300
# UPLOAD_INTENT_COUPLE_HOURLY_CAP=60
# Gallery pipeline limits: hard deadline per session and concurrent sessions per worker.
# SESSION_DEADLINE_MS=900000
# GALLERY_MAX_CONCURRENT=2
# Salt for hashing visitor IPs when de-duplicating gallery views (defaults to
# UPLOAD_TOKEN_SECRET). Raw IPs are never stored.
# GALLERY_EVENT_IP_SALT=
# Comma-separated extra origins allowed to call /api (the app's own origin is always allowed).
# CORS_ALLOWED_ORIGINS=https://www.yourdomain.com
# Express trust-proxy setting (true on Railway/behind one proxy hop; off locally).
TRUST_PROXY=true
# pino log level: trace | debug | info | warn | error.
# LOG_LEVEL=info
# Token (16+ characters) that unlocks the detailed /api/readyz reasons when a
# monitor sends it in the x-readiness-token header. Operators signed in to
# /control see the details without it; everyone else gets ok/degraded only.
# READINESS_DETAIL_TOKEN=
# Cloudflare Turnstile for the couple upload form. Optional: enforced only when
# the secret is set; the site key is exposed to the web app through the venue payload.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# Local development only: Vite dev server port, the API port it proxies /api
# to, and the base path the SPA is served under.
# WEB_PORT=8081
# API_PORT=5000
# BASE_PATH=/
# Default --url for `pnpm run verify:production`.
# VERIFY_PRODUCTION_URL=https://app.yourdomain.com

# --- Supabase database (required) ---
# Dashboard -> Project Settings -> Database -> Connect -> URI (Session pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Pin the Supabase server CA so the database connection is verified, not just
# encrypted (Project Settings -> Database -> SSL configuration -> Download
# certificate). Either the PEM text (\n escapes allowed) or a file path.
# Without it a Supabase/sslmode=require URL still uses TLS but cannot verify
# the server, and the server logs one warning.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_PATH=/etc/ssl/supabase-ca.crt

# --- Supabase storage (required for photo/gallery uploads) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=glimpse
SUPABASE_PUBLIC_BUCKET=glimpse-public

# --- Clerk (auth + organizations) ---
# Required in production (NODE_ENV=production refuses to boot without
# CLERK_SECRET_KEY, a publishable key and CLERK_WEBHOOK_SIGNING_SECRET): owner
# sign-up, the dashboard and billing are all Clerk-gated. Outside production
# the app still starts without them; owner/organization routes return 503 and
# the web app shows a setup notice. Couple galleries and share links work
# regardless. Set CLERK_SECRET_KEY AND a publishable key together - the
# session middleware needs both.
# Dashboard -> API keys. Members sign in with Clerk profiles; one Clerk
# Organization per account owns billing and all venues.
# NOTE: production keys (pk_live_/sk_live_) only work when the site is served
# from the Clerk instance's domain or a subdomain of it. On any other host —
# e.g. the *.up.railway.app URL — the browser gets a 400 from Clerk and
# sign-in cannot load; use pk_test_/sk_test_ development keys there instead.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Same publishable key, exposed to the Vite build for the web app.
VITE_CLERK_PUBLISHABLE_KEY=
# Dashboard -> Webhooks -> endpoint https://YOUR-SERVICE.up.railway.app/api/webhooks/clerk
# Subscribe to: organization.created and organization.updated (name sync).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Stripe billing (organization-level) ---
# The organization owns the subscription and the shared credit pool.
# Webhook endpoint: https://YOUR-SERVICE.up.railway.app/api/billing/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.paused,
# customer.subscription.resumed, customer.subscription.deleted.
# STRIPE_PRICE_* must be the exact Dashboard price ids: an invoice for an
# unknown price answers 500 (Stripe retries) until the ids are fixed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_CREDIT_PACK_10=price_...
# Subscription credits roll over up to this many months of quota (default 3).
# PLAN_CREDIT_ROLLOVER_CAP=3

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Dreemer <noreply@yourdomain.com>

# --- Pricing & public config ---
# Published prices (whole currency units). Shown on / and in the dashboard
# upgrade panel. Display only: Stripe charges whatever STRIPE_PRICE_* say, so
# keep them in sync. Monthly only in this release (annual plans are not built).
PRICING_CURRENCY=USD
PRICING_STARTER_MONTHLY=129
PRICING_GROWTH_MONTHLY=279
PRICING_CREDIT_PACK=59
# Short label printed beside the prices. Empty hides it.
PRICING_LABEL=Launch prices
# Trial: no card, 5 galleries (TRIAL_CREDITS in lib/db) or TRIAL_DAYS, whichever first.
TRIAL_DAYS=14
# Founding-venue cohort shown in the proof row until permissioned aggregates exist.
# Set LEFT to 0 to hide the offer. Operators update it by hand as places fill.
PUBLIC_FOUNDING_SLOTS_LEFT=10
PUBLIC_FOUNDING_SLOTS_TOTAL=10
# Aggregate proof switches on only when at least this many opted-in venues and
# couple galleries exist (organizations.share_aggregates = true).
PUBLIC_PROOF_MIN_VENUES=5
PUBLIC_PROOF_MIN_GALLERIES=50
# Where "Email us" / founding-venue links point (falls back to OUTREACH_REPLY_TO, then EMAIL_FROM).
PUBLIC_CONTACT_EMAIL=
# Couple source photos are deleted this many days after the gallery is delivered.
COUPLE_PHOTO_RETENTION_DAYS=30
# Demo couple reference photos for "Render a sample". Defaults to lib/brand/assets/demo-couple.
# DEMO_COUPLE_DIR=

# --- AI gallery pipeline ---
# OpenAI renders the gallery stills; Gemini still powers the quality judge and
# the venue reference selector, so both keys are required in production.
#
# Production default: gpt-image-2.5-sunburst first. It is OpenAI's precision
# image model, tuned to preserve the subjects and structures of the reference
# images, which is what a gallery still needs (both partners' faces plus the
# real venue). gpt-image-2.5-flare is the faster sibling and takes over when
# Sunburst is unavailable; the Gemini native image models remain last-resort.
#
# Every still is a multi-reference composite, so renders go to the OpenAI image
# edits endpoint (POST /v1/images/edits, multipart with repeated image[] parts,
# up to 16 references). gpt-image models always answer with base64 in
# data[].b64_json; response_format is rejected and is never sent.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_FALLBACK_MODELS=gpt-image-2.5-flare,gemini-3-pro-image
# Legacy chain variables (GEMINI_IMAGE_MODEL, GEMINI_IMAGE_MODELS,
# GEMINI_IMAGE_FALLBACK_MODELS, NANO_BANANA_MODEL) are still read but lose to
# IMAGE_MODELS/IMAGE_MODEL; remove them from old deployments.
# Optional override for the full ordered chain.
# IMAGE_MODELS=gpt-image-2.5-sunburst,gpt-image-2.5-flare,gemini-3-pro-image
# Pin a dated snapshot instead of the moving alias if you need reproducibility.
# IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
#
# Quality steps: low, medium, high, xhigh, max, auto. Cost and latency climb
# steeply past high, which is the production default.
OPENAI_IMAGE_QUALITY=high
# input_fidelity=high is what keeps both faces and the real venue intact.
# OPENAI_IMAGE_INPUT_FIDELITY=high
# Render size. Unset means a per-scene size derived from the scene aspect ratio
# (1:1 1536x1536, 4:3 1792x1344, 3:4 1344x1792, 16:9 2048x1152, 9:16 1152x2048).
# A custom WIDTHxHEIGHT needs both edges divisible by 16, no edge over 3840, a
# ratio within 3:1, and 655,360-8,294,400 total pixels.
# OPENAI_IMAGE_SIZE=2048x1152
# OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
# OPENAI_IMAGE_OUTPUT_COMPRESSION=95
# OPENAI_IMAGE_TIMEOUT_MS=180000
# Scene renders in flight at once for one gallery (default 4).
# GALLERY_RENDER_CONCURRENCY=4
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# Per-image USD unit prices used by render telemetry to report measured COGS
# per gallery (optional; unset means cost is reported as unknown).
# RENDER_PRICE_GPT_IMAGE_2_5_SUNBURST=
# RENDER_PRICE_GPT_IMAGE_2_5_FLARE=
# RENDER_PRICE_GEMINI_3_PRO_IMAGE=

# Gemini: quality judge, venue reference selector, and the last-resort image
# fallback. (The control plane runs on Grok; see XAI_API_KEY below.)
GOOGLE_AI_API_KEY=
# GEMINI_API_KEY is accepted as an alias for GOOGLE_AI_API_KEY.
# GEMINI_API_KEY=
# Timeouts for one Gemini image render and one quality-judge call.
# GEMINI_IMAGE_TIMEOUT_MS=180000
# GALLERY_JUDGE_TIMEOUT_MS=90000
GEMINI_IMAGE_SIZE=2K
# Optional Gemini API base override. Must be v1beta: image generation config
# (responseModalities/imageConfig) is not available on the v1 surface.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Model that picks the venue reference photos for each scene (defaults to the quality model).
# GEMINI_VENUE_SELECTOR_MODEL=gemini-2.5-pro
GENERATED_IMAGE_MIN_EDGE_PX=1024
GENERATED_IMAGE_MIN_CONTRAST=8
GENERATED_IMAGE_MIN_SHARPNESS=6
# Mean-brightness window a generated still must fall in (rejects black or blown-out frames).
# GENERATED_IMAGE_MIN_BRIGHTNESS=18
# GENERATED_IMAGE_MAX_BRIGHTNESS=246
GALLERY_FRAME_ATTEMPTS=4
# Required for the branded MP4 motion reel.
# Leave unset when ffmpeg is on PATH or placed in artifacts/api-server/bin.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Kill an ffmpeg run that takes longer than this (default 120000).
# FFMPEG_TIMEOUT_MS=120000

# Multimodal quality gate. Set GALLERY_QUALITY_GATE=off only for emergency fallback.
# Production startup refuses lowered likeness/venue thresholds and non-Pro QA models.
GEMINI_QUALITY_MODEL=gemini-2.5-pro
GALLERY_QUALITY_GATE=on
GALLERY_MIN_LIKENESS_SCORE=0.82
GALLERY_MIN_PARTNER_LIKENESS_SCORE=0.78
GALLERY_MIN_VENUE_SCORE=0.80
GALLERY_MIN_COMPOSITION_SCORE=0.74
# Acceptance floors: when no retry hits the strict targets above, the best
# attempt still ships if it clears these floors plus all hard integrity checks
# (two distinct real partners, faces visible, no extra people/text). The venue
# owner can review every gallery before it goes out (review_before_send).
GALLERY_FLOOR_LIKENESS_SCORE=0.70
GALLERY_FLOOR_PARTNER_LIKENESS_SCORE=0.66
GALLERY_FLOOR_VENUE_SCORE=0.68
GALLERY_FLOOR_COMPOSITION_SCORE=0.60

# --- Autonomous Business Control Plane ---
# A multi-agent operating system runs on a scheduler inside the API server and
# is supervised from /control. Revenue agents (prospecting, outreach,
# campaigns) find and win venue customers; support, product repair, finance,
# growth, activation, and governance agents keep the business healthy.
# Agents reason with Grok via the xAI API and act only through governed
# actions: anything that contacts a real person or spends money waits for
# operator approval.
# xAI API key for agent reasoning and prospect web research. Without it the
# control plane boots fine but agents stay idle (approvals and metrics
# snapshots still run).
XAI_API_KEY=
# Reasoning model for agents (default grok-4.7). XAI_MODEL is the legacy alias.
# CONTROL_PLANE_MODEL=grok-4.7
# XAI_MODEL=grok-4.7
# Optional xAI base override (OpenAI-compatible Responses API).
# XAI_API_BASE_URL=https://api.x.ai/v1
# Wall clock for one xAI request (default 60000; clamped to 5s-10min).
# GROK_TIMEOUT_MS=60000
# Budget for one agent's tool-calling loop (default 480000 = 8 min; 1-30 min),
# and the runner's hard deadline for a whole run (default 10 minutes).
# CONTROL_PLANE_RUN_BUDGET_MS=480000
# CONTROL_PLANE_RUN_DEADLINE_MINUTES=10
# USD per million tokens used to meter agent spend against the max_daily_ai_usd
# policy. Update when the model or its pricing changes.
# CONTROL_PLANE_PRICE_INPUT_PER_M_USD=3
# CONTROL_PLANE_PRICE_OUTPUT_PER_M_USD=15
# Nightly retention: agent run transcripts and audit events older than these are deleted.
# CONTROL_PLANE_TRANSCRIPT_RETENTION_DAYS=30
# CONTROL_PLANE_AUDIT_RETENTION_DAYS=180
# Set to "off" to disable Grok's server-side web search for the
# prospecting/outreach agents (they then work from existing pipeline data only).
# CONTROL_PLANE_WEB_SEARCH=on
# Comma-separated Clerk account emails allowed to operate /control.
# REQUIRED in production for the control plane UI/API. Outside production the
# control plane fails closed when this is unset unless CONTROL_PLANE_DEV_OPEN=true.
CONTROL_PLANE_OPERATOR_EMAILS=founder@yourdomain.com
# Development only: treat any signed-in user as an operator when the allowlist is unset.
# CONTROL_PLANE_DEV_OPEN=false
# Set to "off" to disable the scheduler worker entirely.
# CONTROL_PLANE_ENABLED=on
# Minutes between business KPI snapshots (default 360).
# CONTROL_PLANE_SNAPSHOT_MINUTES=360

# --- Outreach email studio (control plane) ---
# Studio emails carry the venue's own photos and a personal note; every send
# is a governed action an operator approves in /control -> Outreach. They go
# out through Resend (RESEND_API_KEY / EMAIL_FROM above) with List-Unsubscribe
# + one-click (RFC 8058) headers and a working unsubscribe page.
# The person the notes come from ("Thanks, Sam at Dreemer").
OUTREACH_SENDER_NAME=Sam
# Where replies land (defaults to the EMAIL_FROM address).
# OUTREACH_REPLY_TO=sam@yourdomain.com
# Physical mailing address printed in every footer (CAN-SPAM). Previews show a
# placeholder and a warning until this is set; sends are refused without it.
OUTREACH_POSTAL_ADDRESS=
# Optional mailbox listed alongside the https unsubscribe link.
# OUTREACH_UNSUBSCRIBE_MAILBOX=unsubscribe@yourdomain.com
# Where the one ask points (a booking page, Calendly, etc). Defaults to the
# per-email claim link APP_BASE_URL/claim/:token.
# OUTREACH_CTA_URL=https://cal.com/you/15min
# Resend webhook signing secret (Resend -> Webhooks -> endpoint
# https://YOUR-SERVICE.up.railway.app/api/webhooks/resend; events: email.sent, email.delivered,
# email.delivery_delayed, email.bounced, email.complained, email.opened,
# email.clicked). Bounces and complaints are recorded on the email and
# suppress the address.
RESEND_WEBHOOK_SECRET=

# --- Prospect vetting (control plane) ---
# Every prospect is checked before anyone can draft or send to it: site
# reachable and not parked, TLS, domain age (RDAP), archive history (Wayback),
# MX/SPF/DMARC on the contact domain, mailbox class, address/phone on the site,
# marketplace and social presence. All free; no key needed.
# Optional Tier B: Google Places API (New) key with Places API enabled. Unset = off.
# GOOGLE_PLACES_API_KEY=
# Max Places text searches per UTC day (the free Enterprise SKU is 1,000/month).
# VETTING_PLACES_DAILY_CAP=30
# Days a vetting verdict stays valid; drafts and sends re-run older vetting.
# VETTING_TTL_DAYS=30
# RDAP redirector and Wayback CDX endpoints (tests point these at fixtures).
# VETTING_RDAP_BASE_URL=https://rdap.org
# VETTING_WAYBACK_CDX_URL=https://web.archive.org/cdx/search/cdx

# --- Growth loop (control plane) ---
# Outcome KPIs (signups, activation, trial-to-paid, outbound by segment,
# deliverability), the trial clock, signup attribution, deterministic
# adaptation rules, the experiment evaluator and the weekly operator digest.
# Set to "off" to stop the trial clock, attribution, adaptation and digests;
# KPI snapshots still compute.
# GROWTH_LOOP_ENABLED=on
# Activation funnel "photos ready" threshold (not the session-create gate).
# GROWTH_ACTIVATION_MIN_PHOTOS=3
# Trial nudges: after this many galleries, and this many days before the trial ends.
# GROWTH_NUDGE_GALLERY_COUNT=3
# GROWTH_NUDGE_DAYS_BEFORE_END=4
# Minimum 14-day sends before the deliverability rule acts; minimum sends per
# segment / variant before guidance or reweighting; minimum sample for the evaluator.
# GROWTH_GUARD_MIN_SENDS=50
# GROWTH_SEGMENT_MIN_SENT=20
# GROWTH_VARIANT_MIN_SENT=30
# GROWTH_EXPERIMENT_MIN_N=30
# Weekly digest: UTC weekday (0=Sun..6=Sat) and hour it is generated.
# GROWTH_DIGEST_WEEKDAY=1
# GROWTH_DIGEST_HOUR_UTC=13
# Where lifecycle emails send venues to pick a plan (default: APP_BASE_URL/dashboard).
# GROWTH_PRICING_URL=

# Optional: Google Cloud Storage instead of Supabase (advanced)
# PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket/public
# PRIVATE_OBJECT_DIR=/your-gcs-bucket/.private
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
